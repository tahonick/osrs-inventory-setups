rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid in ['zVBENBUCoocuLjF7oGaomqgzzjo2'];
    }

    // Loadouts collection
    match /loadouts/{loadoutId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // Allow owner to update their loadout
        request.auth.uid == resource.data.userId ||
        // Allow any authenticated user to update likes count
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) ||
        // Allow any authenticated user to add/update tags (community tagging!)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags', 'updatedAt']) ||
        // Allow owner to update category
        (request.auth.uid == resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'updatedAt'])) ||
        // Allow admins to update any loadout
        isAdmin()
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow read: if true;
      // Allow updates to specific fields by different parties
      allow update: if isSignedIn() && (
        // User can update their own profile (including osrsUsername)
        request.auth.uid == userId ||
        // Any authenticated user can update totalLikes
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalLikes', 'lastUpdated']) ||
        // Admins can update any user
        isAdmin()
      );
      // Allow other writes only by the user or admin
      allow create, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Allow access to likes subcollection
      match /likes/{likeId} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Stats collection
    match /stats/global {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Admin configuration
    match /config/admins {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Allow collection group query for likes
    match /{path=**}/likes/{likeId} {
      allow read: if true;
      allow create, delete: if isSignedIn() && request.auth.uid == path[1];
    }
  }
} 